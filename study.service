[Unit]
Description=Study Ders Motivasyon (gunicorn)
After=network.target

[Service]
User=nginx
Group=nginx
WorkingDirectory=/var/www/furkanguven.space/study/app
Environment="PATH=/var/www/furkanguven.space/study/app/venv/bin"
ExecStart=/var/www/furkanguven.space/study/app/venv/bin/gunicorn -w 2 -b 127.0.0.1:5011 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
